SUPER_SCHOLAR_ENVIRONMENT=development
SUPER_SCHOLAR_DATABASE_URL=sqlite:///./data/super_scholar.db
SUPER_SCHOLAR_STORAGE_DIR=./storage
SUPER_SCHOLAR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPER_SCHOLAR_MAX_UPLOAD_MB=256
SUPER_SCHOLAR_OUTBOUND_TIMEOUT_SECONDS=15
SUPER_SCHOLAR_VENUE_CACHE_TTL_HOURS=6

# Fallback-only integration defaults. The normal V3.9 workflow is to configure AI, scholarly sources and OCR
# from App → 系统连接与解析. These values are used only before a UI configuration is saved.

# Optional local OCR. Leave blank to auto-detect tesseract on PATH.
SUPER_SCHOLAR_TESSERACT_CMD=
SUPER_SCHOLAR_OCR_LANGUAGES=eng
SUPER_SCHOLAR_OCR_MIN_NATIVE_TEXT_CHARS=80

# Optional legacy/environment fallback for AI deep research understanding.
# Prefer App → 系统连接与解析 so Base URL, protocol and capabilities can be tested interactively.
SUPER_SCHOLAR_OPENAI_API_KEY=
SUPER_SCHOLAR_OPENAI_MODEL=gpt-5.6
SUPER_SCHOLAR_OPENAI_REASONING_EFFORT=medium
SUPER_SCHOLAR_AI_STREAMING_ENABLED=true
SUPER_SCHOLAR_AI_TRANSPORT_PROFILE=auto
SUPER_SCHOLAR_AI_MAX_TEXT_CHARS=220000
SUPER_SCHOLAR_AI_MAX_VISUAL_ASSETS=8
SUPER_SCHOLAR_AI_MAX_PDF_FILES=2
SUPER_SCHOLAR_AI_FILE_EXPIRY_SECONDS=3600
SUPER_SCHOLAR_AI_MAX_OUTPUT_TOKENS=12000
SUPER_SCHOLAR_AI_CHUNK_TEXT_CHARS=10000
SUPER_SCHOLAR_AI_CHUNK_OUTPUT_TOKENS=1800
SUPER_SCHOLAR_AI_SYNTHESIS_MAX_CHARS=24000
SUPER_SCHOLAR_AI_MAX_PROVIDER_CALLS=8
# Legacy compatibility field; V3.6 sends images as separate one-image requests.
SUPER_SCHOLAR_AI_VISUALS_PER_CHUNK=1
SUPER_SCHOLAR_AI_REQUEST_TIMEOUT_SECONDS=180

# Scholarly data sources. Keys are optional unless your usage requires higher quotas.
# OpenAlex: create a free key at https://openalex.org/settings/api
SUPER_SCHOLAR_OPENALEX_API_KEY=
SUPER_SCHOLAR_OPENALEX_MAX_RESULTS=50
# Crossref polite pool: use a real contact email. Metadata Plus token is optional.
SUPER_SCHOLAR_CROSSREF_EMAIL=
SUPER_SCHOLAR_CROSSREF_API_KEY=
# Semantic Scholar: optional but recommended; request a key at https://www.semanticscholar.org/product/api#api-key-form .
SUPER_SCHOLAR_SEMANTIC_SCHOLAR_API_KEY=
SUPER_SCHOLAR_SCHOLARLY_REQUEST_TIMEOUT_SECONDS=20
# Clarivate Web of Science Journals API: optional paid/entitled source for WoS editions, JCR quartiles and JIF.
# Configure from the UI when possible. Environment values are fallback-only.
SUPER_SCHOLAR_CLARIVATE_JOURNALS_API_KEY=
SUPER_SCHOLAR_CLARIVATE_JOURNAL_LIMIT=36
